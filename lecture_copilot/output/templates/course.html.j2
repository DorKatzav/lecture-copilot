<!doctype html>
<html lang="he" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>{{ page.course_name }} · דף הקורס</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Heebo:wght@500;700;800&family=Assistant:wght@400;600;700&family=IBM+Plex+Mono:wght@400;500&display=swap">
<style>
{% raw %}:root{
  --paper:#F6F6F2; --panel:#FFFFFF; --panel2:#EEEFEA; --ink:#1C2030; --ink2:#4D5468; --mute:#7C8398; --line:#D9DBD3;
  --accent:#C8412F; --accent-soft:#FBE9E5; --local:#1E6F80; --local-soft:#E1F0F2; --cloud:#7A4FA8; --cloud-soft:#EFE7F8;
  --ok:#2E7D4F; --ok-soft:#E3F2E8; --warn:#B7791F; --warn-soft:#FBF1DC; --code:#F0F1EC;
  --shadow:0 1px 2px rgba(20,24,40,.06),0 6px 20px rgba(20,24,40,.06);
}
@media (prefers-color-scheme:dark){
  :root:not([data-theme="light"]){
    --paper:#15171E; --panel:#1D2029; --panel2:#252935; --ink:#ECEDF1; --ink2:#B8BCCB; --mute:#8A90A4; --line:#333846;
    --accent:#F0604B; --accent-soft:#3A2320; --local:#4FB3C6; --local-soft:#16333A; --cloud:#B693E0; --cloud-soft:#2C2340;
    --ok:#6CC58C; --ok-soft:#1D3327; --warn:#E3A94A; --warn-soft:#3A2E17; --code:#11131A;
    --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
  }
}
:root[data-theme="dark"]{
  --paper:#15171E; --panel:#1D2029; --panel2:#252935; --ink:#ECEDF1; --ink2:#B8BCCB; --mute:#8A90A4; --line:#333846;
  --accent:#F0604B; --accent-soft:#3A2320; --local:#4FB3C6; --local-soft:#16333A; --cloud:#B693E0; --cloud-soft:#2C2340;
  --ok:#6CC58C; --ok-soft:#1D3327; --warn:#E3A94A; --warn-soft:#3A2E17; --code:#11131A;
  --shadow:0 1px 2px rgba(0,0,0,.4),0 8px 24px rgba(0,0,0,.35);
}
*{box-sizing:border-box}
body{background:var(--paper);color:var(--ink);font-family:'Assistant',system-ui,-apple-system,sans-serif;font-size:17px;line-height:1.6;margin:0;direction:rtl}
.wrap{max-width:880px;margin:0 auto;padding-inline:20px;padding-block:0 80px}
h1,h2,h3{font-family:'Heebo',system-ui,sans-serif;text-wrap:balance;line-height:1.2;margin:0}
h1{font-size:2.2rem;font-weight:800;letter-spacing:-.01em}
h2{font-size:1.45rem;font-weight:700;margin-block:0 12px;padding-top:6px}
h3{font-size:1.05rem;font-weight:700;margin-block:20px 8px}
p{margin:0 0 12px}
.lead{font-size:1.15rem;color:var(--ink2);max-width:62ch}
a{color:var(--local)}
.eyebrow{font-family:'IBM Plex Mono',monospace;font-size:.72rem;letter-spacing:.12em;text-transform:uppercase;color:var(--mute)}
header.hero{padding-block:36px 24px;border-bottom:1px solid var(--line);margin-bottom:8px}
.meta{display:flex;flex-wrap:wrap;gap:8px 18px;color:var(--mute);font-size:.9rem;margin-top:14px}
section{margin-bottom:48px;scroll-margin-top:64px}
.callout{border-inline-start:4px solid var(--accent);background:var(--accent-soft);padding:12px 16px;border-radius:6px;margin:16px 0}
.callout.local{border-color:var(--local);background:var(--local-soft)}
.callout.ok{border-color:var(--ok);background:var(--ok-soft)}
.callout.warn{border-color:var(--warn);background:var(--warn-soft)}
.callout p:last-child{margin:0}
.pill{display:inline-block;padding:1px 9px;border-radius:999px;font-size:.78rem;font-weight:700;font-family:'Heebo',sans-serif;white-space:nowrap}
.yes{background:var(--ok-soft);color:var(--ok)} .no{background:var(--accent-soft);color:var(--accent)} .maybe{background:var(--warn-soft);color:var(--warn)}
code,pre{font-family:'IBM Plex Mono',ui-monospace,monospace}
code{background:var(--code);padding:1px 6px;border-radius:4px;font-size:.88em;direction:ltr;unicode-bidi:embed}
ul,ol{padding-inline-start:22px;margin:0 0 12px}
li{margin-bottom:6px}
.num{font-family:'IBM Plex Mono',monospace;font-weight:500;direction:ltr;unicode-bidi:isolate;white-space:nowrap}
.exec{border-inline-start:4px solid var(--local);background:var(--local-soft);padding:14px 18px;border-radius:8px}
.exec ol{margin:0;padding-inline-start:22px}
.claim{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:10px 14px;margin:8px 0}
.claim q{quotes:'"' '"';unicode-bidi:isolate}
.claim .actual{margin-top:6px;font-size:.95rem;color:var(--ink2)}
.empty{color:var(--mute)}
h2 small{font-family:'IBM Plex Mono',monospace;font-weight:500;font-size:.8rem;color:var(--mute)}
.search{width:100%;font:inherit;font-size:1.05rem;padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--panel);color:var(--ink);margin:14px 0 6px}
.hint{color:var(--mute);font-size:.85rem;margin-bottom:18px}
.g{display:grid;grid-template-columns:1fr;gap:6px}
.g .row{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:8px 12px}
.g .row b{font-family:'Heebo',sans-serif}
.where{font-family:'IBM Plex Mono',monospace;font-size:.78rem;color:var(--mute);direction:ltr;unicode-bidi:isolate;margin-inline-start:8px}
.hidden{display:none}
.count{color:var(--mute);font-size:.85rem}
.lectures a{display:inline-block;margin:0 0 6px 10px}{% endraw %}
</style>
</head>
<body>
<div class="wrap">
<header class="hero">
  <div class="eyebrow">דף הקורס</div>
  <h1 style="margin-top:8px">{{ page.course_name }}</h1>
  <div class="meta"><span><span class="num">{{ page.lectures | length }}</span> הרצאות</span><span><span class="num">{{ page.glossary | length }}</span> מושגים</span><span><span class="num">{{ page.claims | length }}</span> טענות מסומנות</span></div>
  <input class="search" type="search" id="q" placeholder="מה נאמר על…? (מסנן את הדף)" autocomplete="off">
  <div class="hint">מילון, ★, טענות, שאלות ומשימות מכל ההרצאות. ההקלדה מסננת; תיבת החיפוש בדף החי מחפשת בזיכרון הקורס.</div>
</header>

<section id="lectures" class="lectures">
  <h2>הרצאות</h2>
  {% for l in page.lectures %}<a href="{{ l.folder }}/digest.md"><bdi>{{ l.label }}</bdi> · <span class="num">{{ l.date }}</span></a>{% endfor %}
</section>

<section id="glossary">
  <h2>מילון <small class="count" data-count="glossary">({{ page.glossary | length }})</small></h2>
  <div class="g" data-list="glossary">{% for g in page.glossary %}<div class="row" data-text="{{ g.term }} {{ g.explanation }}"><b><bdi>{{ g.term }}</bdi></b> — {{ g.explanation | r }} <span class="where">{{ g.first_seen }}</span></div>{% endfor %}</div>
</section>

<section id="star">
  <h2>★ למבחן / הודגש <small class="count" data-count="highlights">({{ page.highlights | length }})</small></h2>
  <div class="g" data-list="highlights">{% for h in page.highlights %}<div class="row" data-text="{{ h.text }}">{% if h.kind == "user" %}★ {% endif %}{{ h.text | r }} <span class="where">{{ h.lecture }}</span></div>{% else %}<p class="empty">אין.</p>{% endfor %}</div>
</section>

<section id="claims">
  <h2>טענות מסומנות <small class="count" data-count="claims">({{ page.claims | length }})</small></h2>
  <div class="g" data-list="claims">{% for c in page.claims %}<div class="row claim" data-text="{{ c.text }} {{ c.explanation or '' }}">המרצה אמר: <q dir="{{ c.text | textdir }}">{{ c.text | r }}</q> <span class="pill {{ {'correct': 'yes', 'incorrect': 'no', 'imprecise': 'maybe'}.get(c.verdict or '', 'mw') }}">{{ c.verdict_he }}</span> <span class="where">{{ c.lecture }}</span>{% if c.explanation %}<div class="actual"><b>בפועל:</b> {{ c.explanation | r }}{% for s in c.sources[:2] %} · <a href="{{ s }}" rel="noopener" target="_blank">מקור</a>{% endfor %}</div>{% endif %}</div>{% else %}<p class="empty">אין.</p>{% endfor %}</div>
</section>

<section id="questions">
  <h2>שאלות פתוחות <small class="count" data-count="questions">({{ page.questions | length }})</small></h2>
  <div class="g" data-list="questions">{% for q in page.questions %}<div class="row" data-text="{{ q.text }}">{{ q.text | r }} <span class="where">{{ q.lecture }}</span></div>{% else %}<p class="empty">אין.</p>{% endfor %}</div>
</section>

<section id="tasks">
  <h2>משימות <small class="count" data-count="tasks">({{ page.tasks | length }})</small></h2>
  <div class="g" data-list="tasks">{% for t in page.tasks %}<div class="row" data-text="{{ t.text }}">{{ t.text | r }}{% if t.due %} · עד <span class="num">{{ t.due }}</span>{% endif %}{% if t.owner %} · <bdi>{{ t.owner }}</bdi>{% endif %} <span class="where">{{ t.lecture }}</span></div>{% else %}<p class="empty">אין.</p>{% endfor %}</div>
</section>
</div>
<script>
const q = document.getElementById('q');
q.addEventListener('input', () => {
  const needle = q.value.trim().toLowerCase();
  document.querySelectorAll('[data-list]').forEach(list => {
    let shown = 0;
    list.querySelectorAll('.row').forEach(row => {
      const hit = !needle || row.dataset.text.toLowerCase().includes(needle);
      row.classList.toggle('hidden', !hit); shown += hit;
    });
    const count = document.querySelector(`[data-count="${list.dataset.list}"]`);
    if (count) count.textContent = `(${shown})`;
  });
});
</script>
</body>
</html>
